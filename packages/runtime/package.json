{
  "name": "@phantombot/runtime",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",

"scripts": {
  "dev": "tsx watch src/index.ts",
  "build": "tsc",
  "typecheck": "tsc --noEmit",
  "verify:replay": "tsx src/verification/run-verification.ts",

  "test": "vitest run",
  "test:watch": "vitest"
},

  "dependencies": {
    "dotenv": "17.4.2",
    "zod": "4.4.3",

    "@phantombot/contracts": "workspace:*",
    "@phantombot/database": "workspace:*"
  },

  "devDependencies": {
    "@types/node": "24.12.4",
    "tsx": "4.22.3",
    "typescript": "5.9.3"
  }
}